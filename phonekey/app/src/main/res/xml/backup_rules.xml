<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Profiles contain WireGuard private keys. Never back them up. -->
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
